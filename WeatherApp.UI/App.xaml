<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:WeatherApp.UI.Converters"
             xmlns:local="clr-namespace:WeatherApp.UI"
             x:Class="WeatherApp.UI.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary>
                <toolkit:BoolToObjectConverter x:Key="BoolToObjectConverter" />
                <converters:MultiplyBy70Converter x:Key="MultiplyBy70" />
            </ResourceDictionary>
        </ResourceDictionary>
    </Application.Resources>
</Application>
