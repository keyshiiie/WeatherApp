<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.UI.Resources.Styles.WeatherStyles">

    <!--   Стили для CurrentWeatherPage   -->

    <Style x:Key="WeatherCardBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 25" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{StaticResource WeatherCardBackground}" />
    </Style>

    <Style x:Key="WeatherSectionTitle" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WeatherTextSecondary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="WeatherWhiteLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WeatherText}" />
    </Style>

    <Style x:Key="WeatherWhiteLabelSemiBold" TargetType="Label" BasedOn="{StaticResource WeatherWhiteLabel}">
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="WeatherWhiteLabelMedium" TargetType="Label" BasedOn="{StaticResource WeatherWhiteLabel}">
        <Setter Property="FontFamily" Value="InterMedium" />
    </Style>

    <Style x:Key="WeatherWhite70Label" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource WeatherTextSecondary}" />
    </Style>

    <Style x:Key="WeatherWhite70LabelMedium" TargetType="Label" BasedOn="{StaticResource WeatherWhite70Label}">
        <Setter Property="FontFamily" Value="InterMedium" />
    </Style>

    <Style x:Key="WeatherErrorLabel" TargetType="Label">
        <Setter Property="TextColor" Value="Red" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,10" />
    </Style>

    <Style x:Key="WeatherTemperatureLabel" TargetType="Label" BasedOn="{StaticResource WeatherWhiteLabelSemiBold}">
        <Setter Property="FontSize" Value="48" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="WeatherConditionLabel" TargetType="Label" BasedOn="{StaticResource WeatherWhiteLabelSemiBold}">
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="WeatherIconImage" TargetType="Image">
        <Setter Property="HeightRequest" Value="70" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <Style x:Key="WeatherSmallIcon" TargetType="Image">
        <Setter Property="WidthRequest" Value="25" />
        <Setter Property="HeightRequest" Value="25" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- Стили для детальной информации -->
    <Style x:Key="WeatherDetailLabel" TargetType="Label" BasedOn="{StaticResource WeatherWhiteLabelSemiBold}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="WeatherDetailTitle" TargetType="Label" BasedOn="{StaticResource WeatherWhite70Label}">
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="WeatherDetailValue" TargetType="Label" BasedOn="{StaticResource WeatherWhiteLabelSemiBold}">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- Стиль для индикатора загрузки -->
    <Style x:Key="WeatherLoadingOverlay" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource WeatherOverlay}" />
        <Setter Property="InputTransparent" Value="False" />
    </Style>

    <Style x:Key="WeatherActivityIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource WeatherText}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <!--   Стили для MainPage   -->

    <Style x:Key="MainPageBackground" TargetType="Grid">
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundPrimary}" />
    </Style>

    <Style x:Key="MainSearchBorder" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundWhite}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeShape" Value="RoundRectangle 25,25,25,25" />
    </Style>

    <Style x:Key="MainSearchEntry" TargetType="Entry">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="PlaceholderColor" Value="{StaticResource TextPlaceholder}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="MainSearchIcon" TargetType="Image">
        <Setter Property="WidthRequest" Value="18" />
        <Setter Property="HeightRequest" Value="18" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="MainClearButton" TargetType="Button">
        <Setter Property="Text" Value="✕" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
    </Style>

    <Style x:Key="MainSearchSeparator" TargetType="BoxView">
        <Setter Property="HeightRequest" Value="1" />
        <Setter Property="BackgroundColor" Value="#F0F0F0" />
    </Style>

    <Style x:Key="MainSuggestionItem" TargetType="Grid">
        <Setter Property="Padding" Value="16,10" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style x:Key="MainSuggestionTitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontAttributes" Value="Bold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="MainSuggestionSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
    </Style>

    <Style x:Key="MainLocationButton" TargetType="Button">
        <Setter Property="Text" Value="Определить местоположение" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundWhite}" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="HorizontalOptions" Value="Start" />
        <Setter Property="Margin" Value="0,15,0,0" />
    </Style>

    <Style x:Key="MainRecentLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="TextTransform" Value="Uppercase" />
    </Style>

    <Style x:Key="MainRecentCityBorder" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 25" />
        <Setter Property="Stroke" Value="Transparent" />
        <Setter Property="BackgroundColor" Value="{StaticResource BackgroundWhite}" />
        <Setter Property="Padding" Value="15,0" />
    </Style>

    <Style x:Key="MainRecentCityName" TargetType="Label">
        <Setter Property="FontFamily" Value="InterMedium" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <Style x:Key="MainRecentRemoveButton" TargetType="Button">
        <Setter Property="Text" Value="✕" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
    </Style>

    <!--   Стили для FavoritesPage   -->

    <Style x:Key="FavoritesEmptyViewLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="FavoritesItemBorder" TargetType="Border" 
        BasedOn="{StaticResource MainRecentCityBorder}">
        <Setter Property="Padding" Value="15,10" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="FavoritesCityName" TargetType="Label" 
       BasedOn="{StaticResource MainRecentCityName}">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
    </Style>

    <Style x:Key="FavoritesTemperatureLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontFamily" Value="InterMedium" />
    </Style>

    <Style x:Key="FavoritesConditionLabel" TargetType="Label">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style x:Key="FavoritesActivityIndicator" TargetType="ActivityIndicator">
        <Setter Property="Color" Value="{StaticResource TextPrimary}" />
        <Setter Property="HeightRequest" Value="16" />
        <Setter Property="WidthRequest" Value="16" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="FavoritesRemoveButton" TargetType="Button" 
       BasedOn="{StaticResource MainRecentRemoveButton}">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="WidthRequest" Value="30" />
        <Setter Property="HeightRequest" Value="30" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="Padding" Value="0" />
    </Style>
    
    <!--   Стили для SettingsPage   -->

    <Style x:Key="SettingsSectionTitle" TargetType="Label" 
           BasedOn="{StaticResource MainRecentLabel}" />

    <Style x:Key="SettingsItemBorder" TargetType="Border" 
           BasedOn="{StaticResource MainRecentCityBorder}">
        <Setter Property="Padding" Value="15,0" />
        <Setter Property="Margin" Value="0,0,0,0" />
    </Style>

    <Style x:Key="SettingsItemLabel" TargetType="Label">
        <Setter Property="FontFamily" Value="InterRegular" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="SettingsPicker" TargetType="Picker">
        <Setter Property="FontFamily" Value="InterBold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="HorizontalOptions" Value="End" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <!--   Стили для LoginPage   -->

    <Style x:Key="LoginPageContainer" TargetType="Grid">
        <Setter Property="Style" Value="{StaticResource MainPageBackground}" />
    </Style>

    <Style x:Key="LoginTitle" TargetType="Label">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="TextColor" Value="{StaticResource TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="LoginSubtitle" TargetType="Label">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="Margin" Value="0,0,0,60" />
        <Setter Property="HorizontalOptions" Value="Center" />
    </Style>

    <Style x:Key="LoginLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style x:Key="LoginEntryBorder" TargetType="Border" 
           BasedOn="{StaticResource MainSearchBorder}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="LoginEntry" TargetType="Entry" 
           BasedOn="{StaticResource MainSearchEntry}">
        <Setter Property="IsPassword" Value="True" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style x:Key="LoginButton" TargetType="Button">
        <Setter Property="Text" Value="Войти" />
        <Setter Property="CornerRadius" Value="25" />
        <Setter Property="BackgroundColor" Value="{StaticResource TextSecondary}" />
        <Setter Property="TextColor" Value="{StaticResource BackgroundWhite}" />
        <Setter Property="FontFamily" Value="InterSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HeightRequest" Value="50" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style x:Key="LoginLinkText" TargetType="Label">
        <Setter Property="TextColor" Value="{StaticResource TextTertiary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontFamily" Value="InterRegular" />
    </Style>

    <Style x:Key="LoginLinkUnderline" TargetType="Label" 
           BasedOn="{StaticResource LoginLinkText}">
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>

</ResourceDictionary>