<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="WeatherApp.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:WeatherApp.UI.Views"
    Title="WeatherApp">

    <Shell.FlyoutBehavior>
        Flyout
    </Shell.FlyoutBehavior>

    <ShellItem Title="Погода" Route="main">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </ShellItem>

    <ShellItem Title="Избранное" Route="favorites">
        <ShellContent ContentTemplate="{DataTemplate local:FavoritesPage}" />
    </ShellItem>

    <ShellItem Title="Настройки" Route="settings">
        <ShellContent ContentTemplate="{DataTemplate local:SettingsPage}" />
    </ShellItem>

    <ShellContent Route="LoginPageModal" ContentTemplate="{DataTemplate local:LoginPage}" Shell.PresentationMode="ModalAnimated" />

</Shell>