<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             xmlns:converters="clr-namespace:WeatherApp.UI.Converters"
             x:Class="WeatherApp.UI.Views.SettingsPage"
             Title="Настройки">

    <ContentPage.Resources>
        <converters:EnumDisplayConverter x:Key="EnumDisplay" />
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <Label Text="Единицы измерения" 
                   FontSize="22" 
                   FontAttributes="Bold"
                   TextColor="Black" />

            <!-- Температура -->
            <Border Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Температура" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Picker Title="Выберите единицы измерения температуры"
                            ItemsSource="{Binding TemperatureUnits}"
                            SelectedItem="{Binding SelectedTemperatureUnit}">
                        <Picker.ItemDisplayBinding>
                            <Binding Path=".">
                                <Binding.Converter>
                                    <converters:EnumDisplayConverter />
                                </Binding.Converter>
                            </Binding>
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Давление -->
            <Border Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Давление" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Picker Title="Выберите единицы измерения давления"
                            ItemsSource="{Binding PressureUnits}"
                            SelectedItem="{Binding SelectedPressureUnit}">
                        <Picker.ItemDisplayBinding>
                            <Binding Path=".">
                                <Binding.Converter>
                                    <converters:EnumDisplayConverter />
                                </Binding.Converter>
                            </Binding>
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Скорость ветра -->
            <Border Padding="16" BackgroundColor="White">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Скорость ветра" 
                           FontSize="16" 
                           FontAttributes="Bold" />

                    <Picker Title="Выберите единицы измерения скорости ветра"
                            ItemsSource="{Binding SpeedUnits}"
                            SelectedItem="{Binding SelectedSpeedUnit}">
                        <Picker.ItemDisplayBinding>
                            <Binding Path=".">
                                <Binding.Converter>
                                    <converters:EnumDisplayConverter />
                                </Binding.Converter>
                            </Binding>
                        </Picker.ItemDisplayBinding>
                    </Picker>
                </VerticalStackLayout>
            </Border>

            <!-- Текущие настройки -->
            <Border Padding="16" BackgroundColor="#F8F8F8">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Текущие настройки:" 
                           FontSize="14" 
                           FontAttributes="Bold" />
                    <Label FontSize="14" TextColor="Gray">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Температура: " />
                                <Span Text="{Binding SelectedTemperatureUnit, Converter={StaticResource EnumDisplay}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label FontSize="14" TextColor="Gray">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Давление: " />
                                <Span Text="{Binding SelectedPressureUnit, Converter={StaticResource EnumDisplay}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <Label FontSize="14" TextColor="Gray">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Скорость ветра: " />
                                <Span Text="{Binding SelectedSpeedUnit, Converter={StaticResource EnumDisplay}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>