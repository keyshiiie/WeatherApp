<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.UI.Views.HourlyForecastItem"
             WidthRequest="70">

    <VerticalStackLayout Spacing="2" HorizontalOptions="Center">

        <!-- 1. Температура (верхняя часть) -->
        <Label Text="{Binding TemperatureC, StringFormat='{0}°'}" 
               FontSize="16" FontAttributes="Bold" 
               TextColor="Black" 
               HorizontalOptions="Center" Margin="0,0,0,5"/>

        <!-- 2. Место для иконки погоды -->
        <Image Source="{Binding ConditionIcon}" 
               HeightRequest="30" WidthRequest="30" 
               HorizontalOptions="Center" Margin="0,2"/>

        <!-- 3. Скорость ветра -->
        <Label Text="{Binding WindSpeedKph, StringFormat='{0} км/ч'}" 
               FontSize="11" 
               TextColor="Black" 
               HorizontalOptions="Center" Margin="0,2"/>

        <!-- 4. Время (самая нижняя часть) -->
        <Label Text="{Binding TimeDisplay}" 
               FontSize="11" 
               TextColor="Black" 
               HorizontalOptions="Center" Margin="0,5,0,0"/>

    </VerticalStackLayout>
</ContentView>