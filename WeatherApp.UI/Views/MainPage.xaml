<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             x:Class="WeatherApp.UI.Views.MainPage"
             Title="{Binding Title}">
    <Grid>
        <Grid Padding="20,0,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border>
                <Grid ColumnDefinitions="*, Auto">
                    <Entry Grid.Column="0"
                           x:Name="SearchEntry"
                           Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
                           Placeholder="Введите название города..."/>
                    <Button Grid.Column="1"
                            Text="✕"
                            Command="{Binding ClearSearchCommand}"
                            IsVisible="{Binding SearchQuery, Converter={StaticResource StringToBool}}" />
                </Grid>
            </Border>
            <CollectionView Grid.Row="1"
                            x:Name="SearchResultsList"
                            ItemsSource="{Binding SearchSuggestions}"
                            IsVisible="{Binding ShowSearchSuggestions}"
                            MaximumHeightRequest="200"
                            Margin="0"
                            SelectionMode="None">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="12,8" BackgroundColor="Transparent" Margin="0,3">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer 
                                    Command="{Binding BindingContext.SelectSuggestionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    CommandParameter="{Binding}" />
                            </Grid.GestureRecognizers>
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="Black" />
                                <Label Text="{Binding FullDisplayText}" FontSize="12" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Button Text="Определить местоположение"
                        Command="{Binding GetLocationCommand}"
                        Margin="0,10,0,0"
                        HorizontalOptions="Start"/>
                <StackLayout IsVisible="{Binding RecentCities.Count, Converter={StaticResource IntToBool}}" 
                             Margin="0,10,0,0" 
                             Spacing="8">
                    <FlexLayout BindableLayout.ItemsSource="{Binding RecentCities}"
                                Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Center"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0" Margin="0,0,8,8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=SelectRecentCityCommand}" 
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Border StrokeShape="RoundRectangle 10"
                                            Padding="15,0">
                                        <Grid ColumnDefinitions="Auto, Auto">
                                            <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                                <Label Text="{Binding DisplayName}"
                                                       VerticalOptions="Center" />
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" 
                                                    Text="✕" 
                                                    BackgroundColor="Transparent" 
                                                    TextColor="Black"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=RemoveRecentCityCommand}" 
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>
            </VerticalStackLayout>
        </Grid>
        <Grid 
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#40000000"
            InputTransparent="False">
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}" 
                Color="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>