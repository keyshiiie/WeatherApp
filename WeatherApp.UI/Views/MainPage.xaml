<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             x:Class="WeatherApp.UI.Views.MainPage">

    <Grid Margin="20" RowSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Entry Grid.Row="0"
               x:Name="SearchEntry"
               Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
               Placeholder="Введите название города..."
               FontSize="14"
               HeightRequest="44"/>

        <CollectionView Grid.Row="1"
                        x:Name="SearchResultsList"
                        ItemsSource="{Binding SearchSuggestions}"
                        IsVisible="{Binding ShowSearchSuggestions}"
                        HeightRequest="200"
                        Margin="0"
                        SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="12,8" BackgroundColor="Transparent" Margin="0,3">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding BindingContext.SelectSuggestionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                CommandParameter="{Binding}" />
                        </Grid.GestureRecognizers>
                        <VerticalStackLayout>
                            <Label Text="{Binding Name}" FontSize="14" FontAttributes="Bold" TextColor="Black" />
                            <Label Text="{Binding FullDisplayText}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <HorizontalStackLayout Grid.Row="2" 
                               HorizontalOptions="Start" 
                               VerticalOptions="Start"
                               Spacing="10">

            <!--<ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="Red"
                   HorizontalOptions="Center"
                   FontSize="14" />-->

            <Button Text="Определить местоположение"
                    Command="{Binding GetLocationCommand}"
                    Background="#F0F0F0"
                    TextColor="Black"
                    BorderColor="LightGray"
                    BorderWidth="1"
                    CornerRadius="25"
                    HeightRequest="50"/>

            <StackLayout IsVisible="{Binding RecentCities.Count, Converter={StaticResource IntToBool}}" 
                         Margin="0,10,0,10" Spacing="8">
                <ScrollView Orientation="Horizontal" HeightRequest="50">
                    <StackLayout BindableLayout.ItemsSource="{Binding RecentCities}"
                     Orientation="Horizontal"
                     Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeShape="RoundRectangle 25" 
                                        StrokeThickness="1"
                                        Stroke="LightGray"
                                        BackgroundColor="#F0F0F0"
                                        HeightRequest="50"
                                        Padding="15,10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=SelectRecentCityCommand}" 
                                                  CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}" 
                                               FontSize="14"
                                               TextColor="Black" 
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </StackLayout>
                </ScrollView>
            </StackLayout>
        </HorizontalStackLayout>
    </Grid>
</ContentPage>