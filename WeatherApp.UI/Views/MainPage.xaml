<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             x:Class="WeatherApp.UI.Views.MainPage"
             Title="{Binding Title}">
    
    <Grid BackgroundColor="#EAEAEA">
        <Grid Padding="20,20,20,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Padding="0"
                    StrokeShape="RoundRectangle 25,25,25,25">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ClearFocusCommand}" />
                </Border.GestureRecognizers>

                <Grid RowDefinitions="Auto, Auto">
                    <Grid Grid.Row="0" 
                          ColumnDefinitions="Auto, *, Auto"
                          HeightRequest="40">
                        <Image Grid.Column="0"
                               Source="ic_search.png"
                               WidthRequest="18"
                               HeightRequest="18"
                               VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Margin="16,0,0,0" />

                        <Entry Grid.Column="1"
                               x:Name="SearchEntry"
                               Text="{Binding SearchQuery, Mode=TwoWay, UpdateSourceEventName=TextChanged}"
                               Placeholder="Введите название города..."
                               BackgroundColor="Transparent"
                               TextColor="#222021"
                               PlaceholderColor="#D7D7D7"
                               VerticalOptions="Center"
                               Margin="8,0,0,0"
                               FontSize="14" />

                        <Button Grid.Column="2"
                                Text="✕"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding SearchQuery, Converter={StaticResource StringToBool}}"
                                BackgroundColor="Transparent"
                                TextColor="#999999"
                                FontSize="16"
                                WidthRequest="30"
                                HeightRequest="30"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Margin="0,0,12,0" />
                    </Grid>
                    <BoxView Grid.Row="1"
                             HeightRequest="1"
                             BackgroundColor="#F0F0F0"
                             IsVisible="{Binding ShowSearchSuggestions}" />
                    <CollectionView Grid.Row="1"
                                    x:Name="SearchResultsList"
                                    ItemsSource="{Binding SearchSuggestions}"
                                    IsVisible="{Binding ShowSearchSuggestions}"
                                    MaximumHeightRequest="250"
                                    Margin="0"
                                    BackgroundColor="Transparent"
                                    SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="16,10" 
                                         BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding BindingContext.SelectSuggestionCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            CommandParameter="{Binding}" />
                                    </Grid.GestureRecognizers>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding Name}" 
                                               FontSize="14" 
                                               FontAttributes="Bold" 
                                               TextColor="#222021" />
                                        <Label Text="{Binding FullDisplayText}" 
                                               FontSize="12" 
                                               TextColor="#999999" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Row="2" Spacing="10">
                <Button Text="Определить местоположение"
                        Command="{Binding GetLocationCommand}"
                        BackgroundColor="#FFFFFF"
                        TextColor="#222021"
                        CornerRadius="25"
                        Padding="15,10"
                        FontSize="14"
                        FontFamily="InterMedium"
                        HorizontalOptions="Start"
                        Margin="0,15,0,0" />
                <Label Text="Недавние"
                       TextColor="#979797"
                       TextTransform="Uppercase"/>
                <StackLayout IsVisible="{Binding RecentCities.Count, Converter={StaticResource IntToBool}}" 
                             Margin="0,10,0,0" 
                             Spacing="8">
                    <FlexLayout BindableLayout.ItemsSource="{Binding RecentCities}"
                                Wrap="Wrap"
                                Direction="Row"
                                AlignItems="Center"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="0" Margin="0,0,8,8">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=SelectRecentCityCommand}" 
                                                              CommandParameter="{Binding .}" />
                                    </Grid.GestureRecognizers>
                                    <Border StrokeShape="RoundRectangle 25"
                                            Stroke="Transparent"
                                            BackgroundColor="#FFFFFF"
                                            Padding="15,0">
                                        <Grid ColumnDefinitions="Auto, Auto">
                                            <VerticalStackLayout Grid.Column="0" 
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding DisplayName}"
                                                       FontFamily="InterMedium"
                                                       TextColor="#222021"/>
                                            </VerticalStackLayout>
                                            <Button Grid.Column="1" 
                                                    Text="✕"
                                                    BackgroundColor="Transparent" 
                                                    TextColor="#222021"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:MainPageViewModel}}, Path=RemoveRecentCityCommand}" 
                                                    CommandParameter="{Binding .}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </StackLayout>
            </VerticalStackLayout>
        </Grid>
        <Grid 
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#40000000"
            InputTransparent="False">
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}" 
                Color="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>