<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.UI.Views.HourlyChartView">
    <Grid RowSpacing="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Табы по дням -->
        <HorizontalStackLayout x:Name="DayTabs"
                               Grid.Row="0"
                               Spacing="8"
                               HorizontalOptions="Center"
                               Margin="0,0,0,8">
            <!-- Табы будут создаваться динамически -->
        </HorizontalStackLayout>

        <!-- График -->
        <ScrollView x:Name="MainScrollView"
                    Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GraphicsView x:Name="ChartGraphicsView"
                              Grid.Row="0"
                              HeightRequest="180"
                              HorizontalOptions="Start"
                              Margin="0"/>
                <HorizontalStackLayout x:Name="DataStack"
                                      Grid.Row="1"
                                      Spacing="0"
                                      HorizontalOptions="Start"
                                      Margin="0"/>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>