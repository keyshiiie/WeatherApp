<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.UI.Views.ChangeApiKeyPage"
             Title="API ключ"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundPrimary}, Dark={StaticResource DarkBackgroundPrimary}}">

    <ScrollView Style="{StaticResource ScrollContainer}">
        <VerticalStackLayout Spacing="20" Padding="0,10">

            <!-- Заголовок -->
            <Label Text="Изменить API ключ"
                   FontSize="24"
                   FontFamily="InterSemiBold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <!-- Описание -->
            <Label Text="Для работы приложения необходим API ключ от WeatherAPI.com"
                   FontSize="14"
                   FontFamily="InterRegular"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,10" />

            <!-- Текущий ключ -->
            <Border Style="{StaticResource MainRecentCityBorder}"
                    Padding="15,10"
                    Margin="0,5">
                <Grid ColumnDefinitions="Auto, *">
                    <Label Grid.Column="0"
                           Text="Текущий ключ: "
                           FontFamily="InterMedium"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           Text="{Binding CurrentApiKeyMasked}"
                           FontFamily="InterRegular"
                           FontSize="14"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                           VerticalOptions="Center"
                           HorizontalOptions="End"
                           LineBreakMode="TailTruncation" />
                </Grid>
            </Border>

            <!-- Поле для ввода нового ключа -->
            <Label Text="Новый API ключ"
                   FontFamily="InterMedium"
                   FontSize="14"
                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                   Margin="0,10,0,5" />

            <Border Style="{StaticResource MainSearchBorder}"
                    Padding="0"
                    Margin="0,0,0,5">
                <Entry Placeholder="Введите новый API ключ"
                       Text="{Binding NewApiKey}"
                       Style="{StaticResource LoginEntry}"
                       IsPassword="False"
                       ClearButtonVisibility="WhileEditing"
                       Margin="12,0,12,0" />
            </Border>

            <!-- Кнопки -->
            <HorizontalStackLayout Spacing="10" Margin="0,20,0,0">
                <Button Text="Сохранить"
                        Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        Style="{StaticResource LoginButton}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextPrimary}}"
                        TextColor="{AppThemeBinding Light={StaticResource BackgroundWhite}, Dark={StaticResource TextSecondary}}" />

                <Button Text="Отмена"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource LoginButton}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource TextTertiary}, Dark={StaticResource DarkTextTertiary}}"
                        TextColor="{AppThemeBinding Light={StaticResource BackgroundWhite}, Dark={StaticResource TextPrimary}}" />
            </HorizontalStackLayout>

            <!-- Ссылка на получение ключа -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0"
                       Text="Не знаете где получить ключ? "
                       FontFamily="InterRegular"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource DarkTextSecondary}}"
                       HorizontalOptions="Center" />

                <Label Grid.Column="1"
                       Text="Получить на WeatherAPI.com"
                       FontFamily="InterSemiBold"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                       TextDecorations="Underline"
                       HorizontalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLinkCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <!-- Сообщение об ошибке -->
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource WeatherErrorLabel}"
                   IsVisible="{Binding HasError}"
                   Margin="0,10" />

            <!-- Индикатор загрузки -->
            <Grid IsVisible="{Binding IsLoading}"
                  BackgroundColor="Transparent">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Color="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource DarkTextPrimary}}"
                                   HeightRequest="40"
                                   WidthRequest="40" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>