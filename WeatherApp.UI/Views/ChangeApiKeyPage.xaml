<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.UI.Views.ChangeApiKeyPage"
             Title="API ключ"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundPrimary}, Dark={StaticResource DarkBackgroundPrimary}}">

    <ScrollView Style="{StaticResource ScrollContainer}">
        <VerticalStackLayout Spacing="10"
                             VerticalOptions="Center">

            <!-- Заголовок -->
            <Label Text="Изменить API ключ"
                   Style="{StaticResource ChangeApiKeyTitle}" />

            <!-- Описание -->
            <Label Text="Для работы приложения необходим API-ключ от WeatherAPI.com"
                   Style="{StaticResource ChangeApiKeySubtitle}" />

            <!-- Поле для ввода нового ключа -->
            <Label Text="Новый API ключ:"
                   Style="{StaticResource ChangeApiKeyLabel}" />

            <Border Style="{StaticResource ChangeApiKeyEntryBorder}">
                <Entry Placeholder="Введите новый API ключ"
                       Text="{Binding NewApiKey}"
                       Style="{StaticResource ChangeApiKeyEntry}" />
            </Border>

            <!-- Кнопки -->
            <VerticalStackLayout Spacing="10" Margin="0">
                <Button Command="{Binding SaveCommand}"
                        IsEnabled="{Binding CanSave}"
                        Style="{StaticResource ChangeApiKeySaveButton}" />

                <Button Command="{Binding CancelCommand}"
                        Style="{StaticResource ChangeApiKeyCancelButton}" />
            </VerticalStackLayout>

            <!-- Ссылка на получение ключа -->
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Не знаете где взять? "
                       Style="{StaticResource ChangeApiKeyLinkText}" />

                <Label Style="{StaticResource ChangeApiKeyLinkUnderline}">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenLinkCommand}" />
                    </Label.GestureRecognizers>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="Получить ключ на сайте" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>

            <!-- Сообщение об ошибке -->
            <Label Text="{Binding ErrorMessage}"
                   Style="{StaticResource ChangeApiKeyErrorLabel}"
                   IsVisible="{Binding HasError}" />

            <!-- Индикатор загрузки -->
            <Grid Style="{StaticResource ChangeApiKeyLoadingOverlay}"
                  IsVisible="{Binding IsLoading}">
                <ActivityIndicator IsRunning="{Binding IsLoading}"
                                   Style="{StaticResource ChangeApiKeyActivityIndicator}" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>