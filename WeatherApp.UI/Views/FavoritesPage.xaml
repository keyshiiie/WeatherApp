<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.Core.ViewModels"
             x:Class="WeatherApp.UI.Views.FavoritesPage"
             Title="{Binding Title}">

    <Grid>
        <Grid RowDefinitions="Auto, *" Padding="20,0,20,20">
            <Label Grid.Row="0" Text="{Binding ErrorMessage}" 
                   IsVisible="{Binding HasError}" TextColor="Red" 
                   HorizontalOptions="Center" />
            <CollectionView Grid.Row="1" ItemsSource="{Binding FavoriteCities}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="У вас пока нет избранных городов" 
                           TextColor="Gray" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border>
                            <Grid ColumnDefinitions="*, Auto" Padding="15,0">
                                <VerticalStackLayout Grid.Column="0" 
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}"/>
                                </VerticalStackLayout>
                                <Button Grid.Column="1" 
                                    Text="✕" 
                                    BackgroundColor="Transparent" 
                                    TextColor="Black"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesPageViewModel}}, Path=RemoveFavoriteCommand}" 
                                    CommandParameter="{Binding .}" />

                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesPageViewModel}}, Path=GoToWeatherCommand}" 
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <Grid 
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#40000000"
            InputTransparent="False">
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}" 
                Color="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>