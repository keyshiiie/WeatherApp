<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.Core.ViewModels"
             x:Class="WeatherApp.UI.Views.FavoritesPage"
             Title="{Binding Title}">

    <Grid RowDefinitions="Auto, *" Margin="16">

        <ActivityIndicator Grid.Row="0" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,20" />

        <Label Grid.Row="0" Text="{Binding ErrorMessage}" 
               IsVisible="{Binding HasError}" TextColor="Red" 
               HorizontalOptions="Center" />

        <CollectionView Grid.Row="1" ItemsSource="{Binding FavoriteCities}"
                        SelectionMode="None">
            <CollectionView.EmptyView>
                <Label Text="У вас пока нет избранных городов" 
                       TextColor="Gray" HorizontalOptions="Center" VerticalOptions="Center" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Grid Padding="10" Margin="0,4" ColumnDefinitions="*, Auto" HeightRequest="60">

                        <!-- Левая часть: данные города -->
                        <VerticalStackLayout Grid.Column="0" VerticalOptions="Center" Spacing="2">
                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="16" />
                            <Label Text="{Binding Country}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>

                        <!-- Правая часть: кнопка удалить -->
                        <Button Grid.Column="1" 
                                Text="✕" 
                                BackgroundColor="Transparent" 
                                TextColor="Red" 
                                FontSize="20"
                                VerticalOptions="Center"
                                HorizontalOptions="End"
                                HeightRequest="40" WidthRequest="40" 
                                CornerRadius="20"
                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesPageViewModel}}, Path=RemoveFavoriteCommand}" 
                                CommandParameter="{Binding .}" />

                        <!-- Жест тапа на всю строку (строго в конце Grid) -->
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesPageViewModel}}, Path=GoToWeatherCommand}" 
                                                  CommandParameter="{Binding .}" />
                        </Grid.GestureRecognizers>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>