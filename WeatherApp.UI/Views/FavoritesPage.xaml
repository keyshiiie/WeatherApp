<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.Core.ViewModels"
             x:Class="WeatherApp.UI.Views.FavoritesPage"
             Title="{Binding Title}">

    <Grid Style="{StaticResource MainPageBackground}">
        <Grid Padding="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Label Grid.Row="0" 
                   Text="{Binding ErrorMessage}" 
                   IsVisible="{Binding HasError}" 
                   Style="{StaticResource WeatherErrorLabel}" />

            <CollectionView Grid.Row="1" 
                            ItemsSource="{Binding FavoriteCities}"
                            SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="У вас пока нет избранных городов" 
                           Style="{StaticResource FavoritesEmptyViewLabel}" />
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource FavoritesItemBorder}">
                            <Grid ColumnDefinitions="*, Auto">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesPageViewModel}}, Path=GoToWeatherCommand}" 
                                                          CommandParameter="{Binding .}" />
                                </Grid.GestureRecognizers>

                                <VerticalStackLayout Grid.Column="0" 
                                                     VerticalOptions="Center">
                                    <Label Text="{Binding DisplayName}"
                                           Style="{StaticResource FavoritesCityName}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1" 
                                        Style="{StaticResource FavoritesRemoveButton}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:FavoritesPageViewModel}}, Path=RemoveFavoriteCommand}" 
                                        CommandParameter="{Binding .}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>

        <Grid Style="{StaticResource WeatherLoadingOverlay}"
              IsVisible="{Binding IsBusy}">
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               Style="{StaticResource WeatherActivityIndicator}" />
        </Grid>
    </Grid>
</ContentPage>