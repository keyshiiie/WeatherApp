<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             xmlns:views="clr-namespace:WeatherApp.UI.Views"
             xmlns:converters="clr-namespace:WeatherApp.UI.Converters"
             x:Class="WeatherApp.UI.Views.CurrentWeatherPage"
             Title="{Binding Title}"
             BackgroundColor="{Binding CurrentWeather.ConditionCode, 
                                       Converter={StaticResource WeatherBackground}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavoriteToolbarItem"
                     Text="В избранное"
                     Command="{Binding AddToFavoritesCommand}" />
    </ContentPage.ToolbarItems>
    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ScrollView Grid.Row="0" Padding="20,0,20,20">
                <StackLayout>
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="Red"
                           HorizontalOptions="Center"
                           FontSize="14"
                           Margin="0,10" />
                    <StackLayout HorizontalOptions="Center" 
                                 Spacing="0"
                                 Margin="0,20,0,0">
                        <Label Text="{Binding TemperatureDisplay}"
                               FontSize="48"
                               FontAttributes="Bold"
                               HorizontalOptions="Center"/>
                        <Image Source="{Binding CurrentWeather.ConditionIcon}"
                               WidthRequest="64"
                               HeightRequest="64"
                               HorizontalOptions="Center"
                               Margin="0,5"/>

                        <Label Text="{Binding CurrentWeather.ConditionText}"
                               FontSize="18"
                               HorizontalOptions="Center"/>
                    </StackLayout>
                    <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,20,0,5">
                        <Label Text="Прогноз на 3 дня" 
                               FontSize="18"
                               Grid.Column="0"
                               VerticalOptions="Center"/>
                        <Button Text="Подробнее"
                                Grid.Column="1"
                                HorizontalOptions="Start"/>
                    </Grid>
                    <CollectionView ItemsSource="{Binding ForecastDays}">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="#99FFFFFF" 
                                        Padding="15,0"
                                        Margin="0,15">
                                    <Grid Padding="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <HorizontalStackLayout Grid.Column="0" 
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding DayLabel}"/>
                                        </HorizontalStackLayout>
                                        <Image Grid.Column="1" 
                                               Source="{Binding ConditionIcon}"
                                               WidthRequest="25"
                                               HeightRequest="25"
                                               Margin="0,0,8,0"
                                               VerticalOptions="Center"/>
                                        <Label Grid.Column="2" 
                                               Text="{Binding ConditionText}" 
                                               VerticalOptions="Center" />
                                        <Label Grid.Column="3" 
                                               Text="{Binding ., Converter={StaticResource TemperatureDisplay}, ConverterParameter=max}" TextColor="Black" />
                                        <Label Grid.Column="4" 
                                               Text="/"
                                               Margin="5,0"/>
                                        <Label Grid.Column="5" Text="{Binding ., Converter={StaticResource TemperatureDisplay}, ConverterParameter=min}" TextColor="Black" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                    <Label Text="Прогноз на 72 ч" 
                           FontSize="18"
                           Margin="0,20,0,5"/>

                    <Border BackgroundColor="#99FFFFFF" 
                            Padding="15,5"
                            Margin="0,15">
                        <ScrollView Orientation="Horizontal" 
                                    HorizontalScrollBarVisibility="Always" 
                                    HeightRequest="250">
                            <GraphicsView HeightRequest="230" 
                                          WidthRequest="{Binding HourlyForecast.Count, Converter={StaticResource MultiplyBy70}}"
                                          HorizontalOptions="Start"
                                          Drawable="{Binding TemperatureGraphDrawable}" />
                        </ScrollView>
                    </Border>
                    <Grid RowDefinitions="*, *" 
                          ColumnDefinitions="*, *" 
                          Padding="0" 
                          RowSpacing="8" 
                          ColumnSpacing="8" 
                          Margin="0,15,0,15">
                        <Border Grid.Column="0" 
                                Grid.Row="0"
                                Stroke="#99FFFFFF"
                                BackgroundColor="#99FFFFFF"
                                Padding="15">
                            <VerticalStackLayout>
                                <Label Text="{Binding CurrentWeather.WindDirection, TargetNullValue='-'}"/>
                                <Label Text="{Binding WindSpeedDisplay, TargetNullValue='-'}"/>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="0" 
                                Grid.Row="1"
                                BackgroundColor="#99FFFFFF" 
                                Padding="15">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CurrentWeather.Sunrise, TargetNullValue='-'}"/>
                                    <Label Text="Восход"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CurrentWeather.Sunset, TargetNullValue='-'}"/>
                                    <Label Text="Закат"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                        <Border Grid.Column="1" 
                                Grid.RowSpan="2"
                                BackgroundColor="#99FFFFFF" 
                                Padding="15">
                            <VerticalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Влажность"/>
                                    <Label Text="{Binding CurrentWeather.Humidity, StringFormat='{0}%'}"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Ощущается"/>
                                    <Label Text="{Binding FeelsLikeDisplay}"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Давление"/>
                                    <Label Text="{Binding PressureDisplay}"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="УФ" />
                                    <Label Text="{Binding CurrentWeather.UVIndex, StringFormat='{0}'}"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="Осадки"/>
                                    <Label Text="{Binding CurrentWeather.ChanceOfRainToday, StringFormat='{0}%'}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                    <VerticalStackLayout Spacing="5">
                        <Button Text="Обновить"
                                Command="{Binding RefreshCommand}"/>
                        <Button Text="← Назад к поиску"
                                Command="{Binding GoBackCommand}"/>
                    </VerticalStackLayout>
                </StackLayout>
            </ScrollView>
        </Grid>
        <Grid 
            IsVisible="{Binding IsBusy}"
            BackgroundColor="#40000000"
            InputTransparent="False">
            <ActivityIndicator 
                IsRunning="{Binding IsBusy}" 
                Color="White"
                VerticalOptions="Center"
                HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>