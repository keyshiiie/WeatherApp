<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             xmlns:views="clr-namespace:WeatherApp.UI.Views"
             xmlns:converters="clr-namespace:WeatherApp.UI.Converters"
             x:Class="WeatherApp.UI.Views.CurrentWeatherPage"
             Title="{Binding Title}">

    <ContentPage.Resources>
        <converters:MultiplyBy70Converter x:Key="MultiplyBy70" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavoriteToolbarItem"
                     Text="В избранное"
                     Command="{Binding AddToFavoritesCommand}" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <StackLayout Padding="16" Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,20" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="Red"
                   HorizontalOptions="Center"
                   FontSize="14"
                   Margin="0,10" />

            <!-- Температура -->
            <Label Text="{Binding TemperatureDisplay}"
                   FontSize="48"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="{Binding CurrentWeather.ConditionText}"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <!-- Прогноз на 3 дня -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8" Margin="0,20,0,5">
                <Label Text="Прогноз на 3 дня" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       Grid.Column="0"
                       VerticalOptions="Center" />
                <Button Text="Подробнее"
                        Grid.Column="1"
                        Background="#F0F0F0"
                        TextColor="Black"
                        BorderColor="LightGray"
                        BorderWidth="1"
                        CornerRadius="25"
                        HeightRequest="50"
                        HorizontalOptions="Start"/>
            </Grid>

            <CollectionView ItemsSource="{Binding ForecastDays}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 25" 
                                StrokeThickness="1"
                                Stroke="LightGray"
                                BackgroundColor="#F0F0F0"
                                Padding="15,5"
                                Margin="0,15">
                            <Grid Padding="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <HorizontalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding DayLabel}" TextColor="Black"/>
                                </HorizontalStackLayout>
                                <Label Grid.Column="1" Text="{Binding ConditionText}" VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding ., Converter={StaticResource TemperatureDisplay}, ConverterParameter=max}" />
                                <Label Grid.Column="3" Text="/" TextColor="Black" VerticalOptions="Center" Margin="5,0"/>
                                <Label Grid.Column="4" Text="{Binding ., Converter={StaticResource TemperatureDisplay}, ConverterParameter=min}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Прогноз на 24 часа -->
            <Label Text="Прогноз на 24 ч" FontSize="18" FontAttributes="Bold" Margin="0,20,0,5" />

            <Border StrokeShape="RoundRectangle 25" 
                    StrokeThickness="1"
                    Stroke="LightGray"
                    BackgroundColor="#F0F0F0"
                    Padding="15,5"
                    Margin="0,15">
                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always" HeightRequest="250">
                    <GraphicsView HeightRequest="230" 
                                  WidthRequest="{Binding HourlyForecast.Count, Converter={StaticResource MultiplyBy70}}"
                                  HorizontalOptions="Start"
                                  Drawable="{Binding TemperatureGraphDrawable}" />
                </ScrollView>
            </Border>

            <!-- Дополнительная информация -->
            <Grid RowDefinitions="*, *" 
                  ColumnDefinitions="*, *" 
                  Padding="0" RowSpacing="8" ColumnSpacing="8" Margin="0,15,0,15">

                <!-- Ветер -->
                <Border Grid.Column="0" 
                        Grid.Row="0"
                        StrokeShape="RoundRectangle 25" 
                        StrokeThickness="1"
                        Stroke="LightGray"
                        BackgroundColor="#F0F0F0"
                        Padding="15">
                    <VerticalStackLayout>
                        <Label Text="{Binding CurrentWeather.WindDirection, TargetNullValue='-'}" FontSize="15" FontAttributes="Bold" />
                        <Label Text="{Binding WindSpeedDisplay, TargetNullValue='-'}" FontSize="15" />
                    </VerticalStackLayout>
                </Border>

                <!-- Восход/Закат -->
                <Border Grid.Column="0" 
                        Grid.Row="1"
                        StrokeShape="RoundRectangle 25" 
                        StrokeThickness="1"
                        Stroke="LightGray"
                        BackgroundColor="#F0F0F0"
                        Padding="15">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding CurrentWeather.Sunrise, TargetNullValue='-'}" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Восход" FontSize="14" TextColor="Gray" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="{Binding CurrentWeather.Sunset, TargetNullValue='-'}" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Закат" FontSize="14" TextColor="Gray" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Остальные параметры -->
                <Border Grid.Column="1" 
                        Grid.RowSpan="2"
                        StrokeShape="RoundRectangle 25" 
                        StrokeThickness="1"
                        Stroke="LightGray"
                        BackgroundColor="#F0F0F0"
                        Padding="15">
                    <VerticalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Влажность" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding CurrentWeather.Humidity, StringFormat='{0}%'}" FontSize="14" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Ощущается" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding FeelsLikeDisplay}" FontSize="14" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Давление" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding PressureDisplay}" FontSize="14" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="УФ" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding CurrentWeather.UVIndex, StringFormat='{0}'}" FontSize="14" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Spacing="10">
                            <Label Text="Осадки" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding CurrentWeather.ChanceOfRainToday, StringFormat='{0}%'}" FontSize="14" FontAttributes="Bold" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Button Text="Обновить"
                    Command="{Binding RefreshCommand}"
                    Background="#F0F0F0"
                    TextColor="Black"
                    BorderColor="LightGray"
                    BorderWidth="1"
                    CornerRadius="25"
                    HeightRequest="50"/>

            <Button Text="← Назад к поиску"
                    Command="{Binding GoBackCommand}"
                    Background="#F0F0F0"
                    TextColor="Black"
                    BorderColor="LightGray"
                    BorderWidth="1"
                    CornerRadius="25"
                    HeightRequest="50"/>

        </StackLayout>
    </ScrollView>
</ContentPage>