<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.UI.Views.CurrentWeatherPage"
             Title="{Binding Title}"
             BackgroundColor="{Binding CurrentWeather.IsDay, 
                                       Converter={StaticResource WeatherBackground}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavoriteToolbarItem"
                     IconImageSource="appic_heart_outline.png"
                     Command="{Binding ToggleFavoriteCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollView Grid.Row="0" Padding="20,0,20,20">
                <StackLayout>
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="Red"
                           HorizontalOptions="Center"
                           FontSize="14"
                           Margin="0,10" />

                    <!-- Текущая погода -->
                    <StackLayout HorizontalOptions="Center" 
                                 Spacing="0"
                                 Margin="0,25">
                        <Image HeightRequest="70"
                               HorizontalOptions="Center"
                               Margin="0,5">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource WeatherIconMulti}">
                                    <Binding Path="CurrentWeather.ConditionCode"/>
                                    <Binding Path="CurrentWeather.IsDay"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Label Text="{Binding TemperatureDisplay}"
                               FontSize="48"
                               FontFamily="InterSemiBold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding CurrentWeather.ConditionText}"
                               TextColor="#FFFFFF"
                               FontFamily="InterSemiBold"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                    <!-- Прогноз на 3 дня -->
                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Прогноз на 3 дня" 
                               TextColor="#70FFFFFF"
                               TextTransform="Uppercase"
                               Grid.Column="0"
                               VerticalOptions="Center"/>
                        <Button ImageSource="appic_arrow_right.png"
                                BackgroundColor="Transparent"
                                Grid.Column="1"
                                HorizontalOptions="Start"/>
                    </Grid>

                    <!-- ✅ ИСПОЛЬЗУЕМ ForecastDaysDisplay -->
                    <Border StrokeShape="RoundRectangle 25"
                            Stroke="Transparent"
                            BackgroundColor="#60FFFFFF"
                            Padding="15,10">
                        <CollectionView ItemsSource="{Binding ForecastDaysDisplay}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <HorizontalStackLayout Grid.Column="0" 
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding DayLabel}"
                                                   TextColor="#FFFFFF"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="20">
                                            <Image WidthRequest="25"
                                                   HeightRequest="25"
                                                   Margin="0,0,8,0"
                                                   VerticalOptions="Center">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource WeatherIconMulti}">
                                                        <Binding Path="ConditionCode"/>
                                                        <Binding Path="IsDay"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                            <HorizontalStackLayout Spacing="2">
                                                <Label Text="{Binding MaxTempDisplay}"
                                                       TextColor="#FFFFFF"
                                                       FontFamily="InterMedium"/>
                                                <Label Text="/"
                                                       TextColor="#FFFFFF"
                                                       FontFamily="InterMedium"/>
                                                <Label Text="{Binding MinTempDisplay}"
                                                       TextColor="#70FFFFFF"
                                                       FontFamily="InterMedium"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <!-- Почасовой прогноз -->
                    <Label Text="Почасовой прогноз" 
                           TextColor="#70FFFFFF"
                           TextTransform="Uppercase"
                           Margin="0,20,0,15"/>

                    <!-- ✅ ИСПОЛЬЗУЕМ HourlyForecastDisplay -->
                    <Border StrokeShape="RoundRectangle 25"
                            Stroke="Transparent"
                            BackgroundColor="#60FFFFFF"
                            Padding="0,15">
                        <ScrollView Orientation="Horizontal" 
                                    HorizontalScrollBarVisibility="Never">
                            <VerticalStackLayout>
                                <CollectionView ItemsSource="{Binding HourlyForecastDisplay}"
                                                HorizontalOptions="Start"
                                                VerticalOptions="Center">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Horizontal"
                                                            ItemSpacing="15"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <StackLayout Spacing="4"
                                                         HorizontalOptions="Center"
                                                         WidthRequest="65">
                                                <Label Text="{Binding TimeDisplay}"
                                                       TextColor="#FFFFFF"
                                                       FontFamily="InterMedium"
                                                       FontSize="12"
                                                       HorizontalOptions="Center"/>
                                                <Image WidthRequest="30"
                                                       HeightRequest="30"
                                                       HorizontalOptions="Center">
                                                    <Image.Source>
                                                        <MultiBinding Converter="{StaticResource WeatherIconMulti}">
                                                            <Binding Path="ConditionCode"/>
                                                            <Binding Path="IsDay"/>
                                                        </MultiBinding>
                                                    </Image.Source>
                                                </Image>
                                                <Label Text="{Binding TemperatureDisplay}"
                                                       TextColor="#FFFFFF"
                                                       FontFamily="InterSemiBold"
                                                       FontSize="16"
                                                       HorizontalOptions="Center"/>
                                                <Label Text="{Binding WindSpeedDisplay}"
                                                       TextColor="#70FFFFFF"
                                                       FontFamily="InterMedium"
                                                       FontSize="10"
                                                       HorizontalOptions="Center"/>
                                            </StackLayout>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </ScrollView>
                    </Border>

                    <Grid RowDefinitions="*, *" 
                  ColumnDefinitions="*, *" 
                  Padding="0" 
                  RowSpacing="8" 
                  ColumnSpacing="8" 
                  Margin="0,8,0,8">
                        <Border StrokeShape="RoundRectangle 25"
                        Stroke="Transparent"
                        BackgroundColor="#60FFFFFF"
                        Padding="15,10">
                            <VerticalStackLayout Spacing="4"
                                         VerticalOptions="Center">
                                <Label Text="{Binding CurrentWeather.WindDirection, TargetNullValue='-'}"
                               TextColor="#FFFFFF"
                               FontFamily="InterSemiBold"/>
                                <Label Text="{Binding WindSpeedDisplay, TargetNullValue='-'}"
                               TextColor="#70FFFFFF"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="0" 
                        Grid.Row="1"
                        StrokeShape="RoundRectangle 25"
                        Stroke="Transparent"
                        BackgroundColor="#60FFFFFF"
                        Padding="15,10">
                            <VerticalStackLayout Spacing="4" 
                                         VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CurrentWeather.SunriseDisplay, TargetNullValue='-'}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"/>
                                    <Label Text="Восход"
                                   TextColor="#70FFFFFF"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CurrentWeather.SunsetDisplay, TargetNullValue='-'}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"/>
                                    <Label Text="Закат"
                                   TextColor="#70FFFFFF"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" 
                        Grid.RowSpan="2"
                        StrokeShape="RoundRectangle 25"
                        Stroke="Transparent"
                        BackgroundColor="#60FFFFFF"
                        Padding="15,10">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Влажность"
                                   TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding CurrentWeather.Humidity, StringFormat='{0}%'}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"
                                   Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Ощущается"
                                   TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding FeelsLikeDisplay}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"
                                   Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Давление"
                                   TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding PressureDisplay}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"
                                   Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="УФ"
                                   TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding CurrentWeather.UVIndex, StringFormat='{0}'}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"
                                   Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Осадки"
                                   TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding CurrentWeather.ChanceOfRainToday, StringFormat='{0}%'}"
                                   TextColor="#FFFFFF"
                                   FontFamily="InterSemiBold"
                                   Grid.Column="1"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Grid>

        <!-- Индикатор загрузки -->
        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#40000000"
              InputTransparent="False">
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               Color="White"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>