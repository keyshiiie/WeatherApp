<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             xmlns:views="clr-namespace:WeatherApp.UI.Views"
             xmlns:converters="clr-namespace:WeatherApp.UI.Converters"
             x:Class="WeatherApp.UI.Views.CurrentWeatherPage"
             Title="{Binding Title}"
             BackgroundColor="{Binding CurrentWeather.IsDay, 
                                       Converter={StaticResource WeatherBackground}}">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavoriteToolbarItem"
                     IconImageSource="appic_heart_outline.png"
                     Command="{Binding ToggleFavoriteCommand}" />
    </ContentPage.ToolbarItems>

    <Grid>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ScrollView Grid.Row="0" Padding="20,0,20,20">
                <StackLayout>
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="Red"
                           HorizontalOptions="Center"
                           FontSize="14"
                           Margin="0,10" />

                    <StackLayout HorizontalOptions="Center" 
                                 Spacing="0"
                                 Margin="0,25">
                        <Image HeightRequest="70"
                               HorizontalOptions="Center"
                               Margin="0,5">
                            <Image.Source>
                                <MultiBinding Converter="{StaticResource WeatherIconMulti}">
                                    <Binding Path="CurrentWeather.ConditionCode"/>
                                    <Binding Path="CurrentWeather.IsDay"/>
                                </MultiBinding>
                            </Image.Source>
                        </Image>
                        <Label Text="{Binding TemperatureDisplay}"
                               FontSize="48"
                               FontFamily="InterSemiBold"
                               TextColor="#FFFFFF"
                               HorizontalOptions="Center"/>
                        <Label Text="{Binding CurrentWeather.ConditionText}"
                               TextColor="#FFFFFF"
                               FontFamily="InterSemiBold"
                               HorizontalOptions="Center"/>
                    </StackLayout>

                    <Grid ColumnDefinitions="*, Auto">
                        <Label Text="Прогноз на 3 дня" 
                               TextColor="#70FFFFFF"
                               TextTransform="Uppercase"
                               Grid.Column="0"
                               VerticalOptions="Center"/>
                        <Button ImageSource="appic_arrow_right.png"
                                BackgroundColor="Transparent"
                                Grid.Column="1"
                                HorizontalOptions="Start"/>
                    </Grid>
                    <Border StrokeShape="RoundRectangle 25"
                            Stroke="Transparent"
                            BackgroundColor="#60FFFFFF"
                            Padding="15,10">
                        <CollectionView ItemsSource="{Binding ForecastDays}">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <HorizontalStackLayout Grid.Column="0" 
                                                               VerticalOptions="Center">
                                            <Label Text="{Binding DayLabel}"
                                                   TextColor="#FFFFFF"/>
                                        </HorizontalStackLayout>
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="20">
                                            <Image WidthRequest="25"
                                                   HeightRequest="25"
                                                   Margin="0,0,8,0"
                                                   VerticalOptions="Center">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource WeatherIconMulti}">
                                                        <Binding Path="ConditionCode"/>
                                                        <Binding Path="Hours[0].IsDay"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                            <HorizontalStackLayout Spacing="2">
                                                <Label Grid.Column="3" 
                                                       Text="{Binding ., Converter={StaticResource TemperatureDisplay}, ConverterParameter=max}" 
                                                       TextColor="#FFFFFF"
                                                       FontFamily="InterMedium"/>
                                                <Label Grid.Column="4" 
                                                       Text="/"
                                                       TextColor="#FFFFFF"
                                                       FontFamily="InterMedium"/>
                                                <Label Grid.Column="5" 
                                                       Text="{Binding ., Converter={StaticResource TemperatureDisplay}, ConverterParameter=min}" 
                                                       TextColor="#70FFFFFF"
                                                       FontFamily="InterMedium"/>
                                            </HorizontalStackLayout>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </Border>

                    <Label Text="Почасовой прогноз" 
                           TextColor="#70FFFFFF"
                           TextTransform="Uppercase"
                           Grid.Column="0"
                           VerticalOptions="Center"
                           Margin="0,20,0,15"/>
                    <Border StrokeShape="RoundRectangle 25"
                            Stroke="Transparent"
                            BackgroundColor="#60FFFFFF"
                            Padding="15,10">
                        <ScrollView Orientation="Horizontal" 
                                    HorizontalScrollBarVisibility="Always" 
                                    HeightRequest="250">
                            <GraphicsView HeightRequest="230" 
                                          WidthRequest="{Binding HourlyForecast.Count, Converter={StaticResource MultiplyBy70}}"
                                          HorizontalOptions="Start"
                                          Drawable="{Binding TemperatureGraphDrawable}" />
                        </ScrollView>
                    </Border>

                    <Grid RowDefinitions="*, *" 
                          ColumnDefinitions="*, *" 
                          Padding="0" 
                          RowSpacing="8" 
                          ColumnSpacing="8" 
                          Margin="0,8,0,8">
                        <Border StrokeShape="RoundRectangle 25"
                                Stroke="Transparent"
                                BackgroundColor="#60FFFFFF"
                                Padding="15,10">
                            <VerticalStackLayout Spacing="4"
                                                 VerticalOptions="Center">
                                <Label Text="{Binding CurrentWeather.WindDirection, TargetNullValue='-'}"
                                       TextColor="#FFFFFF"
                                       FontFamily="InterSemiBold"/>
                                <Label Text="{Binding WindSpeedDisplay, TargetNullValue='-'}"
                                       TextColor="#70FFFFFF"/>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="0" 
                                Grid.Row="1"
                                StrokeShape="RoundRectangle 25"
                                Stroke="Transparent"
                                BackgroundColor="#60FFFFFF"
                                Padding="15,10">
                            <VerticalStackLayout Spacing="4" 
                                                 VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CurrentWeather.Sunrise, TargetNullValue='-'}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"/>
                                    <Label Text="Восход"
                                           TextColor="#70FFFFFF"/>
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="10">
                                    <Label Text="{Binding CurrentWeather.Sunset, TargetNullValue='-'}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"/>
                                    <Label Text="Закат"
                                           TextColor="#70FFFFFF"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1" 
                                Grid.RowSpan="2"
                                StrokeShape="RoundRectangle 25"
                                Stroke="Transparent"
                                BackgroundColor="#60FFFFFF"
                                Padding="15,10">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Влажность"
                                           TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding CurrentWeather.Humidity, StringFormat='{0}%'}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"
                                           Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Ощущается"
                                           TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding FeelsLikeDisplay}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"
                                           Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Давление"
                                           TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding PressureDisplay}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"
                                           Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="УФ"
                                           TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding CurrentWeather.UVIndex, StringFormat='{0}'}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"
                                           Grid.Column="1"/>
                                </Grid>
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="Осадки"
                                           TextColor="#70FFFFFF"/>
                                    <Label Text="{Binding CurrentWeather.ChanceOfRainToday, StringFormat='{0}%'}"
                                           TextColor="#FFFFFF"
                                           FontFamily="InterSemiBold"
                                           Grid.Column="1"/>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </StackLayout>
            </ScrollView>
        </Grid>

        <Grid IsVisible="{Binding IsBusy}"
              BackgroundColor="#40000000"
              InputTransparent="False">
            <ActivityIndicator IsRunning="{Binding IsBusy}" 
                               Color="White"
                               VerticalOptions="Center"
                               HorizontalOptions="Center" />
        </Grid>
    </Grid>
</ContentPage>