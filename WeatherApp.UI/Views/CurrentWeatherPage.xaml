<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:WeatherApp.UI.ViewModels"
             xmlns:views="clr-namespace:WeatherApp.UI.Views"
             x:Class="WeatherApp.UI.Views.CurrentWeatherPage"
             Title="{Binding Title}">
    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="FavoriteToolbarItem"
                 Text="В избранное"
                 Command="{Binding AddToFavoritesCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <StackLayout Padding="16" Spacing="12">

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Margin="0,20" />

            <Label Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="Red"
                   HorizontalOptions="Center"
                   FontSize="14"
                   Margin="0,10" />

            <Label Text="{Binding CurrentWeather.TemperatureC, StringFormat='{0}°C'}"
                   FontSize="48"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="{Binding CurrentWeather.ConditionText}"
                   FontSize="18"
                   HorizontalOptions="Center" />

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                <Label Text="Прогноз на 3 дня" 
                       FontSize="18" 
                       FontAttributes="Bold"
                       Grid.Column="0"
                       VerticalOptions="Center" />
                <Button Text="Подробнее ->"
                        BackgroundColor="Transparent"
                        TextColor="Black"
                        CornerRadius="8"
                        Grid.Column="1"/>
            </Grid>

            <CollectionView ItemsSource="{Binding ForecastDays}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="10" Margin="0, 15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <HorizontalStackLayout Grid.Column="0" Spacing="0" VerticalOptions="Center">
                                <Label Text="{Binding DayLabel}" TextColor="Black"/>
                            </HorizontalStackLayout>
                            <Label Grid.Column="1" Text="{Binding ConditionText}" VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding MaxTempC, StringFormat='{0}'}" TextColor="Black" VerticalOptions="Center" />
                            <Label Grid.Column="3" Text="/" TextColor="Black" VerticalOptions="Center" Margin="5,0"/>
                            <Label Grid.Column="4" Text="{Binding MinTempC, StringFormat='{0}'}" TextColor="Black" VerticalOptions="Center" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Прогноз на 24 ч" FontSize="18" FontAttributes="Bold" Margin="0,20,0,5" />
            
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Always" HeightRequest="230">
                <GraphicsView HeightRequest="230" 
      WidthRequest="{Binding HourlyForecast.Count, Converter={StaticResource MultiplyBy70}}"
      HorizontalOptions="Start"
      Drawable="{Binding TemperatureGraphDrawable}" />
            </ScrollView>

            <!-- Детальная информация о погоде -->
            <Grid RowDefinitions="Auto, Auto, Auto, Auto" 
      ColumnDefinitions="*, *, *" 
      Padding="0" RowSpacing="8" ColumnSpacing="8" Margin="0,15,0,15">

                <!-- Строка 0: Заголовки -->
                <Label Grid.Row="0" Grid.Column="0" Text="💨 Ветер" FontSize="14" TextColor="Gray" />
                <Label Grid.Row="0" Grid.Column="1" Text="🌡️ Ощущается" FontSize="14" TextColor="Gray" />
                <Label Grid.Row="0" Grid.Column="2" Text="☀️ УФ-индекс" FontSize="14" TextColor="Gray" />

                <!-- Строка 1: Значения -->
                <!-- Для ветра сделаем два Label: направление и скорость -->
                <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4" HorizontalOptions="Start">
                    <Label Text="{Binding CurrentWeather.WindDirection, TargetNullValue='-'}" FontSize="15" FontAttributes="Bold" />
                    <Label Text="{Binding CurrentWeather.WindSpeedKph, StringFormat='{0} км/ч', TargetNullValue='-'}" FontSize="15" />
                </HorizontalStackLayout>

                <Label Grid.Row="1" Grid.Column="1" Text="{Binding CurrentWeather.FeelsLikeC, StringFormat='{0}°C'}" FontSize="15" FontAttributes="Bold" />
                <Label Grid.Row="1" Grid.Column="2" Text="{Binding CurrentWeather.UVIndex, StringFormat='{0}'}" FontSize="15" FontAttributes="Bold" />

                <!-- Строка 2: Заголовки -->
                <Label Grid.Row="2" Grid.Column="0" Text="🌅 Рассвет" FontSize="14" TextColor="Gray" />
                <Label Grid.Row="2" Grid.Column="1" Text="🌇 Закат" FontSize="14" TextColor="Gray" />
                <Label Grid.Row="2" Grid.Column="2" Text="💧 Влажность" FontSize="14" TextColor="Gray" />

                <!-- Строка 3: Значения -->
                <Label Grid.Row="3" Grid.Column="0" Text="{Binding CurrentWeather.Sunrise, TargetNullValue='-'}" FontSize="15" FontAttributes="Bold" />
                <Label Grid.Row="3" Grid.Column="1" Text="{Binding CurrentWeather.Sunset, TargetNullValue='-'}" FontSize="15" FontAttributes="Bold" />
                <Label Grid.Row="3" Grid.Column="2" Text="{Binding CurrentWeather.Humidity, StringFormat='{0}%'}" FontSize="15" FontAttributes="Bold" />
            </Grid>

            <!-- Отдельный блок: Давление и осадки (в две колонки) -->
            <Grid ColumnDefinitions="*, *" ColumnSpacing="16" Margin="0,0,0,15">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Start">
                    <Label Text="📊 Давление" FontSize="14" TextColor="Gray" />
                    <Label Text="{Binding CurrentWeather.PressureMb, StringFormat='{0} мб'}" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="2" HorizontalOptions="Start" Grid.Column="1">
                    <Label Text="🌧️ Вероятность дождя" FontSize="14" TextColor="Gray" />
                    <Label Text="{Binding CurrentWeather.ChanceOfRainToday, StringFormat='{0}%'}" FontSize="16" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Grid>

            <Button Text="Обновить"
                    Command="{Binding RefreshCommand}"
                    BackgroundColor="Blue"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48" />

            <Button Text="← Назад к поиску"
                    Command="{Binding GoBackCommand}"
                    BackgroundColor="Gray"
                    TextColor="White"
                    CornerRadius="8"
                    HeightRequest="48" />

        </StackLayout>
    </ScrollView>
</ContentPage>